{
  "name": "x-sia-api",
  "main": "./index.js",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "production": {
      "name": "REQUIRED_WORKER_NAME",
      "account_id": "REQUIRED_ACCOUNT_ID",
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "REQUIRED_DATABASE_NAME",
          "database_id": "REQUIRED_DATABASE_ID",
          "migrations_dir": "./migrations"
        }
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "REQUIRED_R2_BUCKET" }],
      "ai": { "binding": "AI" }
    }
  }
}
