# NON-SECRET reference only. Do not put credentials in Compose .env files.
# Development/production-like defaults need no env file.
API_ORIGIN=http://api:8788

# Production: external TLS ingress and separately provisioned Cloudflare Worker.
# Replace placeholders in a non-secret env file outside the repository.
# DEPLOY_ENV=production
# CLOUDFLARE_ACCOUNT_ID=<32-hex-account-id>
# CLOUDFLARE_DATABASE_ID=<D1-UUID>
# CLOUDFLARE_DATABASE_NAME=x-sia-db
# CLOUDFLARE_R2_BUCKET=x-sia-res
# CLOUDFLARE_WORKER_NAME=x-sia-api-production
# API_ORIGIN=https://api.x-sia.example
# SIGN_SECRET_PROVISIONED=production  # owner attestation, never the secret value
# MIGRATIONS_REVIEWED=production     # backup/review attestation, not execution
# PORTAL_IMAGE=registry.example/x-sia/portal@sha256:<64-hex-digest>
# WIKI_IMAGE=registry.example/x-sia/wiki@sha256:<64-hex-digest>
# SITE_IMAGE=registry.example/x-sia/site@sha256:<64-hex-digest>

# Host-only dev gateway overrides (all optional):
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8787
# GATEWAY_API_ORIGIN=http://127.0.0.1:8788
# GATEWAY_APP_ORIGIN=http://127.0.0.1:8081
# GATEWAY_WIKI_ORIGIN=http://127.0.0.1:8082
# GATEWAY_BOOKS_ORIGIN=http://127.0.0.1:8083
# BOOKS_HOST=127.0.0.1
# BOOKS_PORT=8083
# BOOKS_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# WIKI_API_ORIGIN=http://127.0.0.1:8788
